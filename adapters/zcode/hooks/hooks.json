{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/secret-env-zcode.mjs", "session-start"],
            "timeoutMs": 5000,
            "statusMessage": "rsenv 清单注入"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/secret-env-zcode.mjs", "pretooluse"],
            "timeoutMs": 15000,
            "statusMessage": "rsenv"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Read",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/secret-env-zcode.mjs", "pretooluse"],
            "timeoutMs": 5000,
            "statusMessage": "rsenv 文件守卫"
          }
        ]
      }
    ]
  }
}
