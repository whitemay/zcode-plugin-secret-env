{
  "name": "@foperate/secret-env-dsh",
  "version": "0.4.0",
  "description": "rsenv 的 DeepSeek Harness（DSH）bundle：bash 命令门（rsenv parse + 一次性 token eval 链）、文件/通道守卫、密钥清单。运行时经 PATH 上的 rsenv 走协议（protocol 1），本包零依赖。add_secret 挂账（等 rsenv 元数据入库子命令）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "author": "whitemay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whitemay/zcode-plugin-secret-env.git",
    "directory": "adapters/dsh"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "secret-env",
    "credential-injection"
  ],
  "files": [
    "index.js",
    "entry.mjs",
    "guards.mjs",
    "rules.mjs",
    "client.mjs",
    "cordis.patch.yml",
    "locale/",
    "icon.svg",
    "skills/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
