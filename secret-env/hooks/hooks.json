{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "secret-env",
            "args": ["list", "--inject"],
            "timeoutMs": 5000,
            "statusMessage": "secret-env 清单注入"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "process",
            "command": "secret-env",
            "args": ["hook", "zcode"],
            "timeoutMs": 15000,
            "statusMessage": "secret-env"
          }
        ]
      },
      {
        "matcher": "Write|Edit|Read",
        "hooks": [
          {
            "type": "process",
            "command": "secret-env",
            "args": ["hook", "zcode"],
            "timeoutMs": 5000,
            "statusMessage": "secret-env 文件守卫"
          }
        ]
      }
    ]
  }
}
