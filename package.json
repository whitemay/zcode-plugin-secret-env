{
  "name": "@foperate/secret-env",
  "version": "0.3.0",
  "description": "密钥从私有库直达 Bash 子进程环境，模型上下文永不见值。全局 CLI + 多宿主适配（ZCode / opencode / DSH）。",
  "type": "module",
  "keywords": [
    "env",
    "ai-agents",
    "coding-agent",
    "zcode",
    "opencode",
    "credential-management",
    "keepassxc",
    "bitwarden",
    "onepassword",
    "credential-injection"
  ],
  "license": "MIT",
  "author": "whitemay",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whitemay/zcode-plugin-secret-env.git"
  },
  "bin": {
    "secret-env": "./cli.mjs",
    "senv": "./cli.mjs",
    "srun": "./run.mjs",
    "senv-mcp": "./mcp.mjs"
  },
  "exports": {
    "./core.mjs": "./core.mjs",
    "./cli.mjs": "./cli.mjs",
    "./entry.mjs": "./entry.mjs",
    "./mcp.mjs": "./mcp.mjs",
    "./run.mjs": "./run.mjs",
    "./dsh": "./adapters/dsh/secret-env/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "!adapters/tests/",
    "README.md",
    "README.zh-CN.md",
    "adapters/",
    "cli.mjs",
    "core.mjs",
    "docs/INSTALL-DSH.md",
    "entry.mjs",
    "mcp.mjs",
    "run.mjs",
    "secret-env/secrets.example.json",
    "secret-env/skills/"
  ],
  "scripts": {
    "test": "bun secret-env/tests/hook.mjs",
    "test:dsh": "bun adapters/tests/dsh-guard.mjs",
    "test:opencode": "bun adapters/tests/opencode.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./adapters/dsh/secret-env/cordis.patch.yml"
    }
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "kdbxweb": "^2.1.1"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5"
  }
}
